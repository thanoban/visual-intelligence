# Copy to .env and fill in. Everything has a safe local default.

# --- Core ---
DATABASE_URL=sqlite:///./visualsprint.db
STORAGE_DIR=./storage
APP_SECRET_KEY=change-me-for-real-environments
AUTH_TOKEN_TTL_SECONDS=43200
FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Providers ---
# mock = no external services needed (dev/tests). whisper = local faster-whisper.
# hf = fine-tuned Hugging Face checkpoints (Sinhala/Tamil routing).
ASR_PROVIDER=mock
# mock | claude | claude_vertex
LLM_PROVIDER=mock

# --- Claude API (LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
LLM_MAX_OUTPUT_TOKENS=4000
LLM_CHUNK_WINDOW_SECONDS=900
LLM_CHUNK_OVERLAP_SECONDS=120
LLM_EFFORT=high

# --- Google Vertex AI (LLM_PROVIDER=claude_vertex) ---
# Requires: pip install "anthropic[vertex]" and `gcloud auth application-default login`
VERTEX_PROJECT_ID=
VERTEX_REGION=global

# --- ASR model routing (ASR_PROVIDER=hf) ---
ASR_MODEL_EN=openai/whisper-large-v3
ASR_MODEL_SI=Lingalingeswaran/whisper-small-sinhala
ASR_MODEL_TA=vasista22/whisper-tamil-medium
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
NORMALIZED_AUDIO_SAMPLE_RATE_HZ=16000
NORMALIZED_AUDIO_CHANNELS=1
